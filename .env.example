# 复制为 .env 后填写（.env 已在 .gitignore 中，不会提交）
# 主模型：DeepSeek 官方（OpenAI 兼容接口）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

# 备用模型：任意 OpenAI 兼容中转站（主模型故障时自动降级）
HETUNE_API_KEY=sk-xxxxxxxxxxxxxxxx
HETUNE_BASE_URL=https://api.hetune.top
HETUNE_MODEL=gpt-6.1-sol

# 规划/复核角色使用的快模型（成本更低）
FAST_MODEL=deepseek-flash

# 主备顺序（逗号分隔）
PRIMARY_PROVIDER=deepseek
PROVIDER_CHAIN=deepseek,hetune
MAX_STEPS=12
